{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Error"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz ",
        "UseUtcTimestamp": true,
        "SingleLine": true,
        "IncludeScopes": false
      }
    }
  },
  "AllowedHosts": "*",
  "CorsPolicies": {
    "AllowAngularApp": {
      "Origins": [ "http://localhost:4200", "http://localhost:4300" ]
    }
  }
}
